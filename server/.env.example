DB_USER=postgres
DB_HOST=localhost
DB_NAME=service_shop
DB_PASSWORD=
DB_PORT=5432
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_unique_random_64_character_secret
TRUST_PROXY=0
# Password reset: requires a verified sender in your mail provider
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare Turnstile (disabled in local development until BOTH are configured).
# Official TEST keys: use on localhost ONLY, never on public production.
# TURNSTILE_SITEKEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Before public launch replace these with real keys from Cloudflare Turnstile.
# Production requires NODE_ENV=production and HTTPS PUBLIC_BASE_URL.
# Do NOT put real TURNSTILE_SECRET_KEY in GitHub or frontend JavaScript.
